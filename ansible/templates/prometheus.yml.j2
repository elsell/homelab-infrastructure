# Prometheus Configuration - Auto-generated from Ansible Inventory
# Source: ansible/inventory/hosts.yml
# Template: ansible/templates/prometheus.yml.j2
# DO NOT EDIT THIS FILE MANUALLY - Update inventory and re-run playbook

global:
  scrape_interval: 60s
  evaluation_interval: 60s

rule_files:
  - alert-rules.yml

scrape_configs:
  # Home Assistant
  - job_name: "home-assistant"
    metrics_path: {{ hostvars['home']['prometheus_path'] }}
    bearer_token: "{{ hostvars['home']['prometheus_bearer_token'] }}"
    scheme: http
    static_configs:
      - targets:
{% for host in groups['home_assistant'] %}
          - "{{ hostvars[host]['ansible_host'] }}:{{ hostvars[host]['prometheus_port'] }}"
{% endfor %}

  # Prometheus self-monitoring
  - job_name: "prometheus"
    static_configs:
      - targets:
{% for host in groups['prometheus_server'] %}
          - "{{ hostvars[host]['ansible_host'] }}:{{ hostvars[host]['prometheus_port'] }}"
{% endfor %}

  # Node Exporter - All Linux hosts
  - job_name: "node-exporter"
    static_configs:
      - targets:
{% for group in ['mini_pc', 'hypervisors', 'xen_orchestra', 'ubuntu_vms', 'k8s_nodes'] %}
{% for host in groups[group] %}
          - "{{ hostvars[host]['ansible_host'] }}:{{ hostvars[host]['node_exporter_port'] }}"  # {{ host }}
{% endfor %}
{% endfor %}

  # Kubernetes State Metrics
  - job_name: "kube-state-metrics"
    static_configs:
      - targets:
{% for host in groups['k8s_nodes'] %}
{% if hostvars[host]['kube_state_metrics_port'] is defined %}
          - "{{ hostvars[host]['ansible_host'] }}:{{ hostvars[host]['kube_state_metrics_port'] }}"  # {{ host }}
{% endif %}
{% endfor %}

  # TrueNAS (via Graphite Exporter)
  - job_name: "truenas"
    static_configs:
      - targets:
          - "graphite-exporter:9108"  # Receives from TrueNAS via Graphite protocol
